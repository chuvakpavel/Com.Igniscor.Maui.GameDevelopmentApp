<?xml version="1.0" encoding="utf-8"?>

<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:HungerHydra.Models"
    x:Class="HungerHydra.Views.Support.NavigationButtonsView"
    x:Name="View">
    <ScrollView>
        <VerticalStackLayout
            BindableLayout.ItemsSource="{Binding Source={x:Reference View},
                                                 Path=ItemsSource}"
            Margin="10">

            <BindableLayout.ItemTemplate>

                <DataTemplate x:DataType="models:NavigationButtonItem">

                    <VerticalStackLayout Margin="5">


                        <Button
                            Text="{Binding Name}"
                            Command="{Binding Source={x:Reference View},
                                              Path=Command}"
                            CommandParameter="{Binding Path}"
                            BackgroundColor="{StaticResource Tertiary}"
                            TextColor="{StaticResource White}"
                            FontSize="20"
                            Margin="0,10" />

                    </VerticalStackLayout>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </VerticalStackLayout>
    </ScrollView>
</ContentView>